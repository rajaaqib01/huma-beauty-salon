# Copy to .env.local and fill in real values (never commit .env.local)

# Admin login (owner account — server-side only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-long-random-string

# Optional: email, WhatsApp
# ADMIN_2FA_ENABLED=false
# ADMIN_WHATSAPP=
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_RECIPIENT=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GitHub JSON storage — local dev only; on Netlify use Netlify Blobs (enabled by default)
# GITHUB_REPO=rajaaqib01/huma-beauty-salon
# GITHUB_BRANCH=main
# GITHUB_TOKEN=
