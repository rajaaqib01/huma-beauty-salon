# Copy to .env.local and fill in real values (never commit .env.local)

# Admin login (owner account — server-side only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-long-random-string

# Supabase (Project Settings → API) — required on Netlify for persistent admin data
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy JWT keys OR new API keys (both supported):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: email, WhatsApp
# ADMIN_2FA_ENABLED=false
# ADMIN_WHATSAPP=
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_RECIPIENT=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GitHub JSON storage — local dev only; NOT used for saves on Netlify (avoids auto-redeploy)
# GITHUB_REPO=rajaaqib01/huma-beauty-salon
# GITHUB_BRANCH=main
# GITHUB_TOKEN=
